# Solo Manager / platform source mode
SOLO_MANAGER_BASE_URL=https://manager.example.invalid

# SOLO2 read-only submission cache
SOLO2_SERVER=https://solo2.example.invalid
SOLO2_KEYCHAIN_SERVICE=sologsb-qa

# Default task scan root when config.json roots is empty
SOLOGBS_MONITOR_ROOT=/path/to/task-roots
